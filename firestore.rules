rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's pointer to the group they pick in. Only they can see or change it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || request.resource.data.keys().hasOnly(['group']));
    }

    // A group is just an id shared by invite link.
    match /groups/{groupId} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'created']);

      // One document per player: their picks, confidence and comments.
      // Group members can read everyone's; each person can only write their own.
      match /players/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid
          || exists(/databases/$(database)/documents/groups/$(groupId)/players/$(request.auth.uid)));
        allow create, update: if request.auth != null && request.auth.uid == uid
          && exists(/databases/$(database)/documents/groups/$(groupId))
          && request.resource.data.keys().hasOnly(['name', 'picks', 'conf', 'comments', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
